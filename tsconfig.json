{
  "extends": "./tsconfig.base.json",
  "compilerOptions": { "noEmit": true, "baseUrl": "." ,
    "paths": {
      "@social-lite/core": ["packages/core/src/index.ts"],
      "@social-lite/core/*": ["packages/core/src/*"],
      "@social-lite/db": ["packages/db/src/index.ts"],
      "@social-lite/db/*": ["packages/db/src/*"],
      "@social-lite/providers": ["packages/providers/src/index.ts"],
      "@social-lite/providers/*": ["packages/providers/src/*"],
      "@social-lite/services": ["packages/services/src/index.ts"],
      "@social-lite/services/*": ["packages/services/src/*"]
    }
  },
  "include": ["packages/*/src/**/*.ts", "apps/worker/src/**/*.ts", "tests/unit/**/*.ts", "tests/integration/**/*.ts", "tests/contracts/**/*.ts", "tests/e2e/**/*.ts", "scripts/**/*.ts", "vitest.config.ts", "playwright.config.ts"]
}
