{
  "name": "social-lite",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "infra:up": "docker compose -f infra/compose.yaml up -d --wait",
    "infra:down": "docker compose -f infra/compose.yaml down",
    "db:migrate": "tsx packages/db/src/cli.ts migrate",
    "db:seed": "tsx scripts/seed.ts",
    "db:roles": "tsx scripts/db-roles.ts",
    "db:reset": "tsx packages/db/src/cli.ts reset && pnpm db:roles && pnpm db:migrate && pnpm db:roles && pnpm db:seed",
    "dev:web": "pnpm --filter @social-lite/web dev",
    "dev:worker": "pnpm --filter @social-lite/worker dev",
    "build": "pnpm --filter @social-lite/web build && pnpm --filter @social-lite/worker build",
    "typecheck": "tsc -p tsconfig.json --noEmit && pnpm --filter @social-lite/web typecheck",
    "lint": "pnpm --filter @social-lite/web lint",
    "test": "vitest run --project unit --project contracts",
    "test:unit": "vitest run --project unit",
    "test:contracts": "vitest run --project contracts",
    "test:integration": "vitest run --project integration",
    "test:e2e": "playwright test --trace off",
    "test:all": "pnpm test && pnpm test:integration",
    "bench": "tsx scripts/bench/run.ts",
    "bench:compare": "tsx scripts/bench/compare.ts",
    "load:isolation": "tsx --env-file=.env scripts/load-test.ts --isolation"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "pg": "8.23.1",
    "sharp": "0.35.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
