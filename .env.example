# Social Lite configuration. Names and placeholders only — never commit real values.
# Local development defaults match infra/compose.yaml (disposable, local-only services).

APP_ENV=development
APP_BASE_URL=http://localhost:3000
DATABASE_URL=postgres://socialite:socialite-local-only@localhost:54329/socialite_dev
# 32+ random bytes, base64. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=replace-with-32-plus-random-characters-locally
# Envelope encryption key-encryption keys: "<kid>:<base64 32-byte key>[,<old kid>:<old key>]". First is active.
KEY_ENCRYPTION_KEYS=local-dev-1:REPLACE_WITH_BASE64_32_BYTE_KEY

# OIDC identity provider (local: Keycloak realm "social-lite" from infra/compose.yaml)
OIDC_ISSUER=http://localhost:5556/realms/social-lite
OIDC_CLIENT_ID=social-lite-local
OIDC_CLIENT_SECRET=social-lite-local-client-secret
OIDC_ALLOW_INSECURE_HTTP=true

# S3-compatible object storage (local: SeaweedFS)
S3_ENDPOINT=http://localhost:8333
S3_REGION=us-east-1
S3_BUCKET=social-lite-media
S3_ACCESS_KEY_ID=socialite-local-access
S3_SECRET_ACCESS_KEY=socialite-local-secret-not-for-production
S3_FORCE_PATH_STYLE=true

# Email (local: Mailpit SMTP capture, UI at http://localhost:8025)
SMTP_URL=smtp://localhost:1025
EMAIL_FROM="Relay <no-reply@relay.invalid>"

# Simulated provider destinations for development/demo only. MUST be false in production.
ENABLE_MOCK_PROVIDERS=true

# Provider apps (optional here; can also be entered on /setup by the workspace owner)
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v26.0
X_CLIENT_ID=
X_CLIENT_SECRET=
TELEGRAM_WEBHOOK_SECRET=
TIPSIGNAL_SIGNING_SECRET=
ANTHROPIC_API_KEY=
LOG_LEVEL=info
