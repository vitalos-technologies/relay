# Social Lite configuration. Names and placeholders only — never commit real values.
# Local development defaults match infra/compose.yaml (disposable, local-only services).

APP_ENV=development
APP_BASE_URL=http://localhost:3000
# Least-privilege roles (infra/postgres/roles.sql, provisioned locally by `pnpm db:roles`):
#   web app → socialite_app (DML only; audit log append-only) · worker → socialite_worker · migrations → socialite_migrator (DDL)
DATABASE_URL=postgres://socialite_app:socialite-app-local-only@localhost:54329/socialite_dev
WORKER_DATABASE_URL=postgres://socialite_worker:socialite-worker-local-only@localhost:54329/socialite_dev
MIGRATOR_DATABASE_URL=postgres://socialite_migrator:socialite-migrator-local-only@localhost:54329/socialite_dev
# Bootstrap/owner account: used only by `pnpm db:roles` and `pnpm db:reset` (never by the app or worker).
DATABASE_ADMIN_URL=postgres://socialite:socialite-local-only@localhost:54329/socialite_dev
# 32+ random bytes, base64. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=replace-with-32-plus-random-characters-locally
# Envelope encryption key-encryption keys: "<kid>:<base64 32-byte key>[,<old kid>:<old key>]". First is active.
KEY_ENCRYPTION_KEYS=local-dev-1:REPLACE_WITH_BASE64_32_BYTE_KEY

# OIDC identity provider (local: Keycloak realm "social-lite" from infra/compose.yaml)
OIDC_ISSUER=http://localhost:5556/realms/social-lite
OIDC_CLIENT_ID=social-lite-local
OIDC_CLIENT_SECRET=social-lite-local-client-secret
OIDC_ALLOW_INSECURE_HTTP=true

# S3-compatible object storage (local: SeaweedFS)
S3_ENDPOINT=http://localhost:8333
S3_REGION=us-east-1
S3_BUCKET=social-lite-media
S3_ACCESS_KEY_ID=socialite-local-access
S3_SECRET_ACCESS_KEY=socialite-local-secret-not-for-production
S3_FORCE_PATH_STYLE=true

# Email (local: Mailpit SMTP capture, UI at http://localhost:8025)
SMTP_URL=smtp://localhost:1025
EMAIL_FROM="Relay <no-reply@relay.invalid>"

# Simulated provider destinations for development/demo only. MUST be false in production.
ENABLE_MOCK_PROVIDERS=true

# Provider apps (optional here; can also be entered on /setup by the workspace owner)
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v26.0
X_CLIENT_ID=
X_CLIENT_SECRET=
TELEGRAM_WEBHOOK_SECRET=
TIPSIGNAL_SIGNING_SECRET=
ANTHROPIC_API_KEY=
# AI model settings (D32): no model ids or prices live in the code. AI stays off ("AI is not set up") unless the
# provider key above (or Setup) AND AI_MODEL are set. Values come from your AI provider's current documentation.
# AI_MODEL: the provider's model id to use (required to enable AI).
AI_MODEL=
# AI_FALLBACK_MODELS: optional comma-separated model ids for which Relay requests the provider's server-side refusal fallback.
AI_FALLBACK_MODELS=
# AI_MODEL_PRICES: optional JSON {"<model id>": [input USD per million tokens, output USD per million tokens]}.
# Without a price, cost estimates show as unknown; token budgets still apply.
AI_MODEL_PRICES=
LOG_LEVEL=info

# Vitalos Super Admin status endpoint (GET /api/platform/v1/status, ADR-044). Unset = the endpoint answers 404.
# Bearer token, 32+ visible characters (e.g. `openssl rand -hex 32`); _PREVIOUS only while rotating.
RELAY_PLATFORM_STATUS_TOKEN=
RELAY_PLATFORM_STATUS_TOKEN_PREVIOUS=
# Environment slug reported to the Super Admin (e.g. staging). Unset = derived from APP_ENV.
RELAY_ENVIRONMENT=

# Self-hosted Bluesky servers Relay may call (exact hostnames, comma-separated). Empty = Bluesky-hosted only.
BLUESKY_SELF_HOSTED_HOSTS=
